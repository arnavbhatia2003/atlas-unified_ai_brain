  "cards": [
    {
      "dot": "cyan",
      "title": "Source-first questions",
      "items": [
        "Original saved before OCR or optional extraction",
        "Small manuals: whole context; large PDFs: 12 ranked passages",
        "Constrained JSON and verbatim quote validation",
        "Asset RAG: dense + keyword fusion, reranking, cited OKF context"
      ]
    },
    {
      "dot": "amber",
      "title": "Identity boundaries",
      "items": [
        "Manual models and pinouts do not imply installed units",
        "Narrative extraction samples at most 24 passages",
        "Explicit kinds/namespaces and cannot-links block merges"
      ]
    },
    {
      "dot": "rose",
      "title": "Prototype limits",
      "items": [
        "No authentication, tenancy or durable distributed jobs",
        "Review clusters enter views; rebuild is not atomic",
        "Quotes are checked; semantic entailment is not proved"
      ]
    }
  ]
